PROJECT_NAME="HealthMitra API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS=["*"]

# Database Configuration (Self-Hosted PostgreSQL via Docker)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthmitra_db

# Database Web GUI (Adminer)
ADMINER_PORT=8080

# JWT Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
